VPATH= src
CFLAGS+= -Isrc

BUILD_DIR=build_nano/

TARGET=avr
MCU=atmega328p
CC=${TARGET}-gcc
OBJCOPY=${TARGET}-objcopy
SIZE=$(TARGET)-size

CFLAGS+= -Wall -Werror -Os
CFLAGS+= -mmcu=$(MCU) -DF_CPU=16000000UL 
CFLAGS+= -DCONFIG_DCC_ACCESSORY


LDFLAGS=  -mmcu=${MCU} 
LDFLAGS+= ${CFLAGS}



all: build_nano/accessory_servo.hex 
all: build_nano/accessory_signal_2led.hex build_nano/accessory_signal_2led.eep
all: build_nano/accessory_signal_3led.hex build_nano/accessory_signal_3led.eep



accessory_servo_OBJS= accessory_servo.o dcc_decoder.o pwm_servo.o stub.o tick.o
build_nano/accessory_servo: $(addprefix $(BUILD_DIR), $(accessory_servo_OBJS))

build_nano/accessory_servo.hex: build_nano/accessory_servo


accessory_signal_2led_OBJS= accessory_signal_2led.o accessory_signal_cv.o dcc_decoder.o stub.o tick.o cv.o
build_nano/accessory_signal_2led: $(addprefix $(BUILD_DIR), $(accessory_signal_2led_OBJS))
accessory_signal_2led_CFLAGS=-DCONFIG_2LED

build_nano/accessory_signal_2led.hex: build_nano/accessory_signal_2led


accessory_signal_3led_OBJS= accessory_signal_3led.o accessory_signal_cv.o dcc_decoder.o stub.o tick.o cv.o
build_nano/accessory_signal_3led: $(addprefix $(BUILD_DIR), $(accessory_signal_3led_OBJS))
accessory_signal_3led_CFLAGS=-DCONFIG_3LED

build_nano/accessory_signal_3led.hex: build_nano/accessory_signal_3led

clean:
	rm -rf build_nano/*


program_servo: build_nano/accessory_servo.hex
	sudo avrdude -c usbasp -p m328p -U flash:w:build_nano/accessory_servo.hex



program_signal_2led: build_nano/accessory_signal_2led.hex build_nano/accessory_signal_2led.eep
	sudo avrdude -c usbasp -p m328p -U flash:w:build_nano/accessory_signal_2led.hex -Ueeprom:w:build_nano/accessory_signal_2led.eep

program_signal_3led: build_nano/accessory_signal_3led.hex build_nano/accessory_signal_3led.eep
	sudo avrdude -c usbasp -p m328p -U flash:w:build_nano/accessory_signal_3led.hex -Ueeprom:w:build_nano/accessory_signal_3led.eep



include build.mk

